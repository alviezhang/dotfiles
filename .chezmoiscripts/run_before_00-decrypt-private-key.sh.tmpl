#!/bin/bash
# 保证 ~/.config/chezmoi/key.txt 是 age-recipient.txt 对应的私钥。
# 已匹配时直接退出，不读取任何口令源；缺失或不匹配时才用口令解密 key.txt.age。
# 只依赖 chezmoi 内置的 age，不需要 age / expect 二进制。
set -euo pipefail
umask 077

CHEZMOI="${CHEZMOI_EXECUTABLE:-chezmoi}"
SOURCE_DIR="{{ .chezmoi.sourceDir }}"
RECIPIENT="{{ include "age-recipient.txt" | trim }}"
KEY_DIR="$HOME/.config/chezmoi"
KEY_FILE="$KEY_DIR/key.txt"
KEY_AGE="$SOURCE_DIR/key.txt.age"
PW_FILE="${XDG_CONFIG_HOME:-$HOME/.config}/dotfiles/passphrase"
KEYCHAIN_BIN="$SOURCE_DIR/scripts/dotfiles-keychain"
KEYCHAIN_SERVICE="dotfiles-passphrase"
ACCOUNT="${USER:-$(id -un)}"

warn() { echo "warning: $*" >&2; }

key_matches() {
    [ -s "$1" ] && [ "$("$CHEZMOI" age-keygen -y "$1" 2>/dev/null)" = "$RECIPIENT" ]
}

file_mode() {
    if [ "$(uname -s)" = "Darwin" ]; then stat -f '%Lp' "$1"; else stat -c '%a' "$1"; fi
}

key_matches "$KEY_FILE" && exit 0

# 口令来源（按优先级）：
#   1. CHEZMOI_AGE_PASSWORD（CI / 一次性场景；同用户进程可见，不作稳态存储）
#   2. macOS Keychain，经 scripts/dotfiles-keychain 读取（iCloud 钥匙串同步）
#   3. ~/.config/dotfiles/passphrase（必须 0600）
#   4. 交互输入
# 来源缺失时安静跳过；来源存在但为空或读取失败时警告并跳过；
# 拿到口令但解密失败时直接报错，不再尝试下一个来源。
PASSWORD=""
PW_SOURCE=""

if [ -n "${CHEZMOI_AGE_PASSWORD:-}" ]; then
    PASSWORD="$CHEZMOI_AGE_PASSWORD"
    PW_SOURCE="env CHEZMOI_AGE_PASSWORD"
elif [ "${CHEZMOI_AGE_PASSWORD+set}" = "set" ]; then
    warn "CHEZMOI_AGE_PASSWORD is set but empty; falling through"
fi

if [ -z "$PASSWORD" ] && [ "$(uname -s)" = "Darwin" ]; then
    kc_rc=0
    kc_pw=$("$KEYCHAIN_BIN" get "$KEYCHAIN_SERVICE" "$ACCOUNT" 2>/dev/null) || kc_rc=$?
    case "$kc_rc" in
        0)  if [ -n "$kc_pw" ]; then
                PASSWORD="$kc_pw"
                PW_SOURCE="macOS Keychain (service=$KEYCHAIN_SERVICE, account=$ACCOUNT)"
            else
                warn "Keychain entry '$KEYCHAIN_SERVICE' is empty; falling through"
            fi ;;
        44) ;;
        *)  warn "Keychain lookup via $KEYCHAIN_BIN exited with $kc_rc; falling through" ;;
    esac
    unset kc_pw
fi

if [ -z "$PASSWORD" ] && [ -f "$PW_FILE" ]; then
    mode=$(file_mode "$PW_FILE" 2>/dev/null || echo "?")
    if [ "$mode" != "600" ]; then
        warn "$PW_FILE has mode $mode, expected 600; refusing to read"
    else
        file_pw=""
        IFS= read -r file_pw < "$PW_FILE" || true
        file_pw="${file_pw%"${file_pw##*[![:space:]]}"}"
        if [ -n "$file_pw" ]; then
            PASSWORD="$file_pw"
            PW_SOURCE="file $PW_FILE"
        else
            warn "$PW_FILE is empty or unreadable; falling through"
        fi
        unset file_pw
    fi
fi

mkdir -p "$KEY_DIR"
TMP_KEY=$(mktemp "$KEY_DIR/key.txt.XXXXXX")
trap 'rm -f "$TMP_KEY"' EXIT

if [ -n "$PASSWORD" ]; then
    echo "decrypt: $KEY_FILE missing or mismatched; decrypting key.txt.age with passphrase from $PW_SOURCE" >&2
    rc=0
    err=$(printf '%s\n' "$PASSWORD" \
        | "$CHEZMOI" --no-tty age decrypt --passphrase --output "$TMP_KEY" "$KEY_AGE" 2>&1 >/dev/null) || rc=$?
    if [ "$rc" -ne 0 ]; then
        cat >&2 <<EOF
Error: failed to decrypt $KEY_AGE (exit $rc).
  Passphrase from: $PW_SOURCE
  chezmoi said:    ${err#Enter passphrase: }

Most likely the stored passphrase does not match key.txt.age:
  - The passphrase was rotated elsewhere but key.txt.age was not pushed/pulled
    (on the rotating machine: commit and push key.txt.age; here: chezmoi update).
  - The passphrase source holds a stale value; update the Keychain entry or
    $PW_FILE, or unset it and run chezmoi apply in a terminal to type it.
EOF
        exit 1
    fi
else
    echo "decrypt: $KEY_FILE missing or mismatched and no passphrase source configured; prompting" >&2
    if ! "$CHEZMOI" age decrypt --passphrase --output "$TMP_KEY" "$KEY_AGE"; then
        echo "Error: interactive decryption of $KEY_AGE failed (wrong passphrase, or no terminal)." >&2
        echo "  See README 'Secrets' for CHEZMOI_AGE_PASSWORD / Keychain / $PW_FILE." >&2
        exit 1
    fi
fi

if ! key_matches "$TMP_KEY"; then
    echo "Error: key.txt.age decrypted, but the key does not match age-recipient.txt." >&2
    echo "  key.txt.age and age-recipient.txt in $SOURCE_DIR are out of sync; $KEY_FILE left unchanged." >&2
    exit 1
fi

chmod 600 "$TMP_KEY"
mv -f "$TMP_KEY" "$KEY_FILE"
trap - EXIT
