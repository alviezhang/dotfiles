#!/bin/bash
# 每次 apply 都检查；插件齐全时立即退出。vim-plug 只能在终端里可靠安装，
# 没有终端时只提示，不让 apply 失败。
set -euo pipefail
{{ template "lib.sh" . }}

command -v vim >/dev/null 2>&1 || { echo "vim not installed; skip vim plugins"; exit 0; }

PLUG_VIM="$HOME/.vim/autoload/plug.vim"
PLUGGED="$HOME/.vim/plugged"
if [ ! -s "$PLUG_VIM" ]; then
  mkdir -p "$(dirname "$PLUG_VIM")"
  fetch https://raw.githubusercontent.com/junegunn/vim-plug/master/plug.vim "$PLUG_VIM"
fi

# vimrc 里声明的插件目录名，即 Plug 'owner/repo' 的 repo 部分
missing=""
while IFS= read -r name; do
  [ -d "$PLUGGED/$name" ] || missing="$missing $name"
done < <(sed -nE "s#^[[:space:]]*Plug[[:space:]]+'[^/']+/([^']+)'.*#\1#p" "$HOME/.vimrc")
[ -z "$missing" ] && exit 0

if [ -t 0 ] && [ -t 1 ]; then
  vim +'PlugInstall --sync' +qa
else
  echo "vim plugins missing:$missing — no terminal; run 'chezmoi apply' in a terminal or :PlugInstall in vim"
fi
