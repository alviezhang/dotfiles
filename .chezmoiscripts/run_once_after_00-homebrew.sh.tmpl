{{ if eq .chezmoi.os "darwin" -}}
#!/bin/bash
# 安装 Homebrew 本体。Command Line Tools 是前置条件（README），git 来自那里
set -euo pipefail
{{ template "lib.sh" . }}

command -v brew >/dev/null 2>&1 && exit 0

tmp=$(mktemp -d)
trap 'rm -rf "$tmp"' EXIT
fetch https://raw.githubusercontent.com/Homebrew/install/HEAD/install.sh "$tmp/install.sh"
/bin/bash "$tmp/install.sh"
{{ end -}}
