{{ if .installGo -}}
#!/bin/bash
set -euo pipefail
{{ template "lib.sh" . }}

command -v go >/dev/null 2>&1 && exit 0

{{ if eq .chezmoi.os "darwin" -}}
brew install go
{{- else -}}
if command -v apt-get >/dev/null 2>&1; then
  run_as_root env DEBIAN_FRONTEND=noninteractive apt-get update -q
  run_as_root env DEBIAN_FRONTEND=noninteractive apt-get install -y golang-go
elif command -v pacman >/dev/null 2>&1; then
  run_as_root pacman -Syu --needed --noconfirm go
else
  echo "error: no supported package manager (apt-get/pacman); cannot install Go" >&2
  exit 1
fi
{{- end }}
{{ end -}}
