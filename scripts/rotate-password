#!/bin/bash
# 轮换保护 key.txt.age 的口令；只依赖 chezmoi（内置 age），不需要 age / expect。
set -euo pipefail
umask 077

REPO_DIR="$(cd "$(dirname "$0")/.." && pwd)"
SCRIPTS_DIR="$REPO_DIR/scripts"
AGE_KEY="$HOME/.config/chezmoi/key.txt"
KEY_AGE="$REPO_DIR/key.txt.age"
RECIPIENT_FILE="$REPO_DIR/age-recipient.txt"
KEYCHAIN_SERVICE="dotfiles-passphrase"
KEYCHAIN_BIN="$SCRIPTS_DIR/dotfiles-keychain"
DEFAULT_FILE="${XDG_CONFIG_HOME:-$HOME/.config}/dotfiles/passphrase"
ACCOUNT="${USER:-$(id -un)}"

AUTO_GENERATE=false
PASSWORD_LENGTH=32
USE_FILE=false
EXPLICIT_FILE=""

usage() {
  cat <<'EOF'
Usage: scripts/rotate-password [--auto] [--length N] [--file [PATH]]

Rotate the age passphrase that protects key.txt.age, and store it
in the platform-appropriate location:

  - macOS (default): macOS Keychain (service=dotfiles-passphrase, account=$USER)
  - Linux (default): ~/.config/dotfiles/passphrase (mode 0600)
  - --file [PATH]:   Force file storage (default path if PATH omitted).
                     On macOS this also removes the Keychain entry, which
                     would otherwise take precedence with the old passphrase.

Options:
  --auto           Auto-generate a new passphrase (A-Za-z0-9) via openssl.
  --length N       Password length for --auto. Default: 32.
  --file [PATH]    Write password to PATH instead of platform default.
                   PATH defaults to ~/.config/dotfiles/passphrase.

Afterwards, commit and push key.txt.age so other machines pick it up.
EOF
}

die() { echo "Error: $*" >&2; exit 1; }

generate_password() {
  local out
  out=$(openssl rand -base64 $(( $1 * 2 )) | tr -dc 'A-Za-z0-9' | head -c "$1") || true
  printf '%s' "$out"
}

while [ $# -gt 0 ]; do
  case "$1" in
    --auto)
      AUTO_GENERATE=true
      ;;
    --length)
      shift
      [ -n "${1:-}" ] || die "--length requires a value."
      PASSWORD_LENGTH="$1"
      ;;
    --file)
      USE_FILE=true
      if [ -n "${2:-}" ] && [ "${2:0:1}" != "-" ]; then
        EXPLICIT_FILE="$2"
        shift
      fi
      ;;
    -h|--help)
      usage
      exit 0
      ;;
    *)
      echo "Unknown argument: $1" >&2
      usage
      exit 1
      ;;
  esac
  shift
done

[[ "$PASSWORD_LENGTH" =~ ^[0-9]+$ ]] && [ "$PASSWORD_LENGTH" -gt 0 ] || die "--length must be a positive integer."

CHEZMOI="$(command -v chezmoi || true)"
[ -n "$CHEZMOI" ] || { [ -x "$HOME/.local/bin/chezmoi" ] && CHEZMOI="$HOME/.local/bin/chezmoi"; }
[ -n "$CHEZMOI" ] || die "chezmoi not found on PATH or in ~/.local/bin."

[ -f "$AGE_KEY" ] || die "age key not found: $AGE_KEY
Run 'chezmoi apply' first to decrypt it, or see 'Recovery' in README.md."

# 先确认要重新加密的确实是仓库公钥对应的私钥，避免把错误的密钥封进 key.txt.age
[ "$("$CHEZMOI" age-keygen -y "$AGE_KEY" 2>/dev/null)" = "$(tr -d '[:space:]' < "$RECIPIENT_FILE")" ] \
  || die "$AGE_KEY does not match age-recipient.txt; refusing to rotate."

if [ "$USE_FILE" = true ]; then
  STORAGE="file"; TARGET_FILE="${EXPLICIT_FILE:-$DEFAULT_FILE}"
elif [ "$(uname -s)" = "Darwin" ]; then
  STORAGE="keychain"
  [ -x "$KEYCHAIN_BIN" ] || die "dotfiles-keychain not found at $KEYCHAIN_BIN"
else
  STORAGE="file"; TARGET_FILE="$DEFAULT_FILE"
fi

if [ "$AUTO_GENERATE" = true ]; then
  command -v openssl >/dev/null 2>&1 || die "openssl not found."
  NEW_PASSWORD="$(generate_password "$PASSWORD_LENGTH")"
  [ "${#NEW_PASSWORD}" -eq "$PASSWORD_LENGTH" ] || die "failed to generate a passphrase of length $PASSWORD_LENGTH."
  echo "Auto-generated a new passphrase (A-Za-z0-9, length=${PASSWORD_LENGTH})."
else
  printf "Enter new passphrase: "
  read -rs NEW_PASSWORD
  echo
  printf "Confirm new passphrase: "
  read -rs CONFIRM
  echo
  [ "$NEW_PASSWORD" = "$CONFIRM" ] || die "passphrases do not match."
  unset CONFIRM
fi
[ -n "$NEW_PASSWORD" ] || die "passphrase must not be empty."
case "$NEW_PASSWORD" in
  *$'\n'*|*$'\r'*) die "passphrase must not contain line breaks." ;;
esac

# 仓库目录（可能在 Dropbox 等同步目录里）只放密文，用于原子替换 key.txt.age；
# 解密校验出的私钥明文放在系统临时目录，口令文件在它自己的目录里原子写入
STAGE_DIR=$(mktemp -d "$REPO_DIR/.rotate.XXXXXX")
PLAIN_DIR=$(mktemp -d)
PW_TMP=""
trap 'rm -rf "$STAGE_DIR" "$PLAIN_DIR"; [ -z "$PW_TMP" ] || rm -f "$PW_TMP"' EXIT
NEW_AGE="$STAGE_DIR/key.txt.age"

printf '%s\n%s\n' "$NEW_PASSWORD" "$NEW_PASSWORD" \
  | "$CHEZMOI" --no-tty age encrypt --passphrase --output "$NEW_AGE" "$AGE_KEY" >/dev/null 2>&1 \
  || die "re-encryption failed; key.txt.age unchanged."

# 用新口令解回来逐字节比对，确认新文件可用后才动任何存储
printf '%s\n' "$NEW_PASSWORD" \
  | "$CHEZMOI" --no-tty age decrypt --passphrase --output "$PLAIN_DIR/check" "$NEW_AGE" >/dev/null 2>&1 \
  && cmp -s "$PLAIN_DIR/check" "$AGE_KEY" \
  || die "verification of the re-encrypted key failed; key.txt.age unchanged."

# 先写入并回读口令存储，成功后才替换 key.txt.age
case "$STORAGE" in
  keychain)
    # helper 的 set 是先删后加：写入失败时旧条目可能已被删除（且会同步到其他 Mac）
    printf '%s' "$NEW_PASSWORD" | "$KEYCHAIN_BIN" set "$KEYCHAIN_SERVICE" "$ACCOUNT" \
      || die "failed to write to Keychain; key.txt.age unchanged.
The old Keychain entry may have been removed; if so, the next decrypt falls back to
~/.config/dotfiles/passphrase or the interactive prompt. Rerun rotate-password to retry."
    STORED=$("$KEYCHAIN_BIN" get "$KEYCHAIN_SERVICE" "$ACCOUNT" 2>/dev/null) \
      || die "failed to read back from Keychain; key.txt.age unchanged."
    [ "$STORED" = "$NEW_PASSWORD" ] || die "Keychain readback mismatch; key.txt.age unchanged."
    echo "Stored passphrase in macOS Keychain (service=$KEYCHAIN_SERVICE, account=$ACCOUNT, iCloud Keychain sync enabled)."
    ;;
  file)
    mkdir -p "$(dirname "$TARGET_FILE")"
    chmod 700 "$(dirname "$TARGET_FILE")" 2>/dev/null || true
    PW_TMP=$(mktemp "$(dirname "$TARGET_FILE")/.passphrase.XXXXXX")
    printf '%s' "$NEW_PASSWORD" > "$PW_TMP" || die "failed to write passphrase; key.txt.age unchanged."
    chmod 600 "$PW_TMP"
    mv -f "$PW_TMP" "$TARGET_FILE" || die "failed to install $TARGET_FILE; key.txt.age unchanged."
    PW_TMP=""
    [ "$(cat "$TARGET_FILE")" = "$NEW_PASSWORD" ] || die "file readback mismatch; key.txt.age unchanged."
    echo "Wrote passphrase file: $TARGET_FILE"
    ;;
esac
unset STORED

chmod 644 "$NEW_AGE"
mv -f "$NEW_AGE" "$KEY_AGE"
echo "Passphrase rotated; key.txt.age re-encrypted."

# Keychain 的优先级高于口令文件，残留的旧条目会让解密使用旧口令
if [ "$STORAGE" = "file" ] && [ "$(uname -s)" = "Darwin" ] && [ -x "$KEYCHAIN_BIN" ]; then
  if "$KEYCHAIN_BIN" delete "$KEYCHAIN_SERVICE" "$ACCOUNT"; then
    echo "Removed the Keychain entry so the passphrase file is used (the deletion syncs to other Macs)."
  else
    echo "warning: could not remove Keychain entry '$KEYCHAIN_SERVICE'; delete it manually, or it will shadow $TARGET_FILE" >&2
  fi
fi

unset NEW_PASSWORD
echo
echo "Next: commit and push key.txt.age so other machines get the new encryption:"
echo "  git -C \"$REPO_DIR\" add key.txt.age && git -C \"$REPO_DIR\" commit -m 'chore: rotate age passphrase' && git -C \"$REPO_DIR\" push"
