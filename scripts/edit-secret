#!/bin/bash
# 解密 → 编辑 → 有改动才重新加密。用 chezmoi 内置 age 和 chezmoi.toml 里的 identity/recipient。
set -euo pipefail
umask 077

REPO_DIR="$(cd "$(dirname "$0")/.." && pwd)"

if [ -z "${1:-}" ]; then
  echo "Usage: $0 <encrypted-file>"
  echo "Example: $0 git-identity.toml.age"
  exit 1
fi

CHEZMOI="$(command -v chezmoi || true)"
[ -n "$CHEZMOI" ] || { [ -x "$HOME/.local/bin/chezmoi" ] && CHEZMOI="$HOME/.local/bin/chezmoi"; }
[ -n "$CHEZMOI" ] || { echo "chezmoi not found on PATH or in ~/.local/bin" >&2; exit 1; }

FILE="$REPO_DIR/$1"
[ -f "$FILE" ] || { echo "File not found: $FILE" >&2; exit 1; }

TMP_DIR=$(mktemp -d)
trap 'rm -rf "$TMP_DIR"' EXIT
PLAIN="$TMP_DIR/$(basename "${1%.age}")"

"$CHEZMOI" decrypt --output "$PLAIN" "$FILE"
BEFORE=$(shasum "$PLAIN")

${EDITOR:-vim} "$PLAIN"

if [ "$(shasum "$PLAIN")" = "$BEFORE" ]; then
  echo "No changes."
  exit 0
fi

"$CHEZMOI" encrypt --output "$TMP_DIR/new.age" "$PLAIN"
chmod 644 "$TMP_DIR/new.age"
mv -f "$TMP_DIR/new.age" "$FILE"
echo "Encrypted and saved: $1"
